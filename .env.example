# Supabase project URL. Server-only; do not prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key. Server-only; never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Public base URL used in reminder emails. Use HTTPS outside local development.
APP_BASE_URL=http://localhost:3000

# Protects /api/cron/reminders. Vercel Cron sends this as a Bearer token.
CRON_SECRET=replace-with-a-long-random-secret

# Secret used to hash Return Tokens and sign short-lived HttpOnly sessions.
RETURN_SESSION_SECRET=replace-with-a-long-random-secret

# Resend email configuration.
RESEND_API_KEY=replace-with-your-resend-api-key
REMINDER_FROM_EMAIL=WishBottle <reminders@example.com>

# Optional: return token lifetime in days. Defaults to 14.
RETURN_TOKEN_TTL_DAYS=14

# Test only: create reminders a few minutes ahead without changing scheduler logic.
# Leave blank or unset in production.
REMINDER_TEST_INTERVAL_MINUTES=
# Separate secrets for the two one-time token permission domains.
EMAIL_VERIFICATION_SECRET=replace-with-a-long-random-secret
PIN_RESET_SECRET=replace-with-a-different-long-random-secret

# One-time token and resend controls.
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
EMAIL_VERIFICATION_RESEND_SECONDS=60
PIN_RESET_TOKEN_TTL_MINUTES=30
PIN_RESET_RESEND_SECONDS=60

